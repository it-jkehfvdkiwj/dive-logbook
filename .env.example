# Datenbank (lokal: siehe docker-compose.yml · Vercel: wird von Neon automatisch gesetzt)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/divelog"
# Optional: direkte Verbindung für Migrationen (Neon setzt das automatisch)
# DATABASE_URL_UNPOOLED=""

# Passwortschutz – leer lassen = kein Login (nur lokal empfohlen)
APP_PASSWORD=""

# Name für die Begrüßung beim ersten Seed
SEED_DISPLAY_NAME="Quirin"

# SSI-Sync (optional): Zugangsdaten deines MySSI-Kontos für "Sync now" ohne Eingabe
SSI_EMAIL=""
SSI_PASSWORD=""
# Optional: aktiviert den nächtlichen Auto-Sync (Vercel Cron, 04:00 UTC). Beliebiger langer Zufallswert.
CRON_SECRET=""
